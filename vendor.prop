## Bluetooth
bluetooth.device.default_name=Tanix X4
bluetooth.profile.hfp.ag.enabled=false
bluetooth.profile.opp.enabled=false
bluetooth.profile.pbap.server.enabled=false
ro.vendor.btmodule=multibt

## FRP
ro.frp.pst=/dev/block/by-name/frp

# Dolby
ro.vendor.platform.support.dolbyvision=false
vendor.media.support.dolbyvision=false

## NRDP
ro.vendor.nrdp.modelgroup=REFPLUSSNA4K905X4GTVSTB
ro.vendor.nrdp.oemmodel=onn_onn. Streaming Device 4K pro
ro.vendor.nrdp.validation=ninja_10

## SOC
ro.soc.model=AMLS905X4

## Wi-Fi
wifi.direct.interface=p2p0
